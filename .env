; Copier ce fichier en .env puis adapter les valeurs.
; Les commentaires commencent par un point-virgule, jamais par un dièse.
; Une valeur contenant ( ) ! ? & ~ ^ | doit être entre guillemets, par exemple DB_PASS="mon(mot)de!passe"
DB_HOST=localhost
DB_NAME=NADVENT
DB_USER=root
DB_PASS="Mouad321@"

;Mode développement : connexion automatique du responsable n° 1 (retirer le point-virgule pour l'activer)
